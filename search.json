---
layout: null
permalink: /search.json
sitemap: false
---
{% assign docs = site.posts | concat: site.skills | concat: site.scout_skills | concat: site.guides | concat: site.scout_guides %}[
{% for doc in docs %}  {
    "title": {{ doc.title | jsonify }},
    "url": {{ doc.url | relative_url | jsonify }},
    "type": {% case doc.collection %}{% when "posts" %}"Field Note"{% when "skills" %}"Claude Skill"{% when "scout_skills" %}"Scout Skill"{% when "guides" %}"Guide"{% when "scout_guides" %}"Scout Guide"{% else %}"Page"{% endcase %},
    "date": {% if doc.date %}{{ doc.date | date: "%b %d, %Y" | jsonify }}{% else %}""{% endif %},
    "tags": {% if doc.tags and doc.tags.size > 0 %}{{ doc.tags | jsonify }}{% elsif doc.topics and doc.topics.size > 0 %}{{ doc.topics | jsonify }}{% else %}[]{% endif %},
    "desc": {% if doc.description %}{{ doc.description | strip_newlines | jsonify }}{% else %}""{% endif %},
    "text": {{ doc.content | strip_html | normalize_whitespace | truncate: 4000 | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{% endfor %}]
